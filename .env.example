# Pulse AI Environment Configuration
# Copy this file to backend/.env and populate your Gemini API key:
# cp .env.example backend/.env

# Google Gemini API Key (Required for live AI features)
# Obtain your key at: https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here

# Optional: Preferred Gemini Model (Defaults to gemini-2.5-flash)
# Supported: gemini-2.5-flash, gemini-1.5-flash, gemini-2.0-flash
GEMINI_MODEL=gemini-2.5-flash

# Backend server configuration (Local dev)
PORT=8000
HOST=127.0.0.1
